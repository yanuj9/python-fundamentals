
def square(num) :
    return num * num

def cube(num) :
    return num * num * num

# def operate(num, operation):
#     return operation(num) # square(num) -> Functional programming -> higher order function


def operate(num, operation):
    res = 0

    for n in num:
        res += operation(n)
    
    return res


